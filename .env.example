# ============================================================
# Momentum Desk settings. Copy this file to ".env" and fill it in.
# Never share .env or upload it anywhere public: it holds your keys.
# ============================================================

# ---- Market data (required). Free keys: alpaca.markets > Paper account > API keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# iex = free (sees part of the market), sip = paid plan (full market volume and real spreads)
ALPACA_FEED=iex
# Tickers to always scan, comma separated (optional)
WATCHLIST=

# ---- Trading window, New York time
# Use TRADE_FROM=07:00 to also get pre-market setups
TRADE_FROM=09:30
TRADE_UNTIL=11:00
MORNING_BRIEF_AT=09:00

# ---- Your risk: alerts then include the exact share count (0 = off)
ACCOUNT_SIZE=0
RISK_PCT=1
# No more BUY signals after this many losing trades in one day
MAX_LOSSES_PER_DAY=3
# Max trades per stock per day (a stock that already lost is never re-entered)
MAX_TRADES_PER_STOCK=2

# ---- Phone alerts: fill at least one. See README.md, "Phone alerts".
# Telegram (recommended): create a bot with @BotFather, paste the token,
# then run: python momentum_scanner.py --telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy (no account needed): pick a long random topic name nobody can guess,
# install the ntfy app and subscribe to the same topic
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Discord: Server settings > Integrations > Webhooks > Copy URL
DISCORD_WEBHOOK_URL=

# What to send: ready = GET READY + BUY signals, buy = BUY signals only
ALERT_LEVEL=buy
ALERT_MIN_SCORE=60
# Morning brief, open, window open/close, holidays
ALERT_MARKET_EVENTS=true

# ---- Server (needed when running online)
# 0.0.0.0 = reachable from the internet (then SET A PASSWORD). 127.0.0.1 = this computer only
HOST=127.0.0.1
PORT=8765
# Password for the dashboard (the browser will ask; the user name can be anything)
DASHBOARD_PASSWORD=
# Your server's address, added as a link in alerts, e.g. http://203.0.113.10:8765
PUBLIC_URL=
# Where signals_log.csv and alert_state.json are saved (default: this folder)
DATA_DIR=
SCAN_INTERVAL=10
LOG_LEVEL=INFO
